#!/usr/bin/env bash
# Keep the transcription engine loaded, so runs do not wait for it.
#
#   ./engine start            load it and leave it running
#   ./engine stop             let go of the card
#   ./engine status           is it up?
#   ./engine restart          stop, then start
#   ./engine log              what it has been doing
#
# Loading the engine costs ~70s with a warm compile cache, and it is paid per
# RUN. On an hour-long meeting that is noise; on a 3-minute voice memo it is the
# entire wall clock. Measured on a 3090: 145s to transcribe 3 minutes of audio
# cold, 25s with the engine already up.
#
# Nothing requires this. ./transcribe and the web UI use the engine when it is
# here and load their own when it is not, so starting it is an optimisation and
# stopping it is always safe -- including mid-queue, which finishes on the
# engine it already has.
#
# It holds VRAM while it runs. After MS_ENGINE_IDLE_SLEEP seconds idle (default
# 900) it hands the card back and keeps only the weights, waking in about a
# second when the next job arrives. Set it to 0 to never let go.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="${MS_WORK:-$HERE}"
SOCK="$WORK/run/engine.sock"
PIDF="$WORK/run/engine.pid"
LOG="$WORK/run/engine.log"
PY="$(. "$HERE/env.sh" 2>/dev/null; echo "${MS_PY:-python3}")"

# Refuse while the box is still building itself. vast marks an instance ready
# when the CONTAINER boots, minutes before provisioning finishes, so ssh lets you
# in and this directory already looks like an install. Running now fails in ways
# that read as bugs in this script -- a missing weight, an engine that will not
# fit beside the one provisioning is about to start -- rather than as "wait".
# The marker is written by vast/provision.sh and removed when it is done, so a
# plain ./setup.sh install never has one and is never blocked.
provisioning_guard() {
  # Provisioning itself runs this script -- the warm-up transcription, and
  # ./engine start when supervisor did not. Without this exemption the guard
  # blocked the very steps that make the box ready: the warm-up refused, so the
  # compile cache stayed empty, so the engine took longer than provisioning's
  # wait, so it reported "not resident" on a box that was otherwise perfect.
  # One guard, three symptoms, none of them looking like the cause.
  [ -z "${MS_PROVISIONING:-}" ] || return 0
  local m="$1/.provisioning"
  [ -f "$m" ] || return 0
  local since; since="$(cat "$m" 2>/dev/null)"
  echo "meetscribe is still being set up on this machine (started ${since:-recently})." >&2
  echo "It takes about 5-8 minutes: ~2 GB of weights, then a one-off engine compile." >&2
  echo "  watch it:   tail -f /var/log/onstart.log" >&2
  echo "  it is done when:  $1/.provisioned exists" >&2
  exit 75            # EX_TEMPFAIL: try again shortly, nothing is wrong
}

# status stays answerable while provisioning: it is how you check.
case "${1:-status}" in start|restart) provisioning_guard "$WORK" ;; esac

# 0 = up, 2 = up but holding code older than pipeline/ on disk. BOTH are up.
# Treating 2 as dead would have `start` launch a second engine onto a card that
# already has one, which is the worst outcome available here.
alive() {
  "$PY" "$HERE/pipeline/engined.py" --status --sock "$SOCK" >/dev/null 2>&1
  case "$?" in 0|2) return 0 ;; *) return 1 ;; esac
}
# Is a daemon there, INCLUDING one that is still loading? alive() cannot tell:
# the socket it tests for is bound at the very end of build_engine, so for the
# 70-400s of a load a starting engine looks exactly like no engine. Starting a
# second one onto the same card is not a harmless duplicate -- each sizes itself
# from the card's TOTAL memory, so whichever reaches the allocator second dies,
# and the survivor is no longer the one the pid file names.
loading() {
  local pid; pid="$(cat "$PIDF" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "${1:-status}" in
  start)
    if alive; then echo "already running ($SOCK)"; exit 0; fi
    if loading; then
      echo "already starting (pid $(cat "$PIDF")) — it is still loading."
      echo "watch it with:  $0 log"
      exit 0
    fi
    shift                       # anything left is passed through, e.g. --window 60
    mkdir -p "$WORK/run"
    # setsid so it outlives the shell that started it -- including an ssh
    # session, which is how it is usually started on a rented box.
    MS_WORK="$WORK" HF_HOME="${HF_HOME:-$WORK/.hf_home}" \
    VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT:-$WORK/.vllm_cache}" \
    OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}" TOKENIZERS_PARALLELISM=false \
    VLLM_LOGGING_LEVEL="${VLLM_LOGGING_LEVEL:-WARNING}" \
      setsid nohup "$PY" -u "$HERE/pipeline/engined.py" --serve --sock "$SOCK" \
        "$@" >"$LOG" 2>&1 </dev/null &
    echo $! > "$PIDF"
    echo "==> loading the engine; this takes ~70s once"
    # 480s, not 300: the FIRST load on a machine costs 240-400s while
    # torch.compile fills its cache, so a 5-minute bound timed out on exactly
    # the cold box it mattered on -- and left the engine loading behind it, so
    # the obvious retry collided with its own first attempt.
    START_PID="$(cat "$PIDF")"
    for _ in $(seq 1 240); do
      alive && { echo "==> ready — $(grep -m1 'engine resident' "$LOG" || true)"; exit 0; }
      # Ask about the process we started, not whatever the pid file says now.
      kill -0 "$START_PID" 2>/dev/null || { echo "!! it exited:"; tail -20 "$LOG"; exit 1; }
      sleep 2
    done
    # Still alive, just slow. Do NOT kill it and do NOT call this a failure --
    # it is very likely about to succeed, and saying "failed" invites a second
    # start on top of the first.
    echo "!! still loading after 8 minutes. It is probably still coming up:"
    echo "     $0 status     $0 log"
    exit 1 ;;
  stop)
    PID="$(cat "$PIDF" 2>/dev/null || true)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
      # The process GROUP, not the pid. vLLM runs the model in a separate
      # VLLM::EngineCore process, and killing only the parent leaves that one
      # alive holding the whole KV cache -- 17.6 GiB of a 24 GiB card, measured
      # here. Nothing then says the engine is still there: the socket is gone,
      # `status` says "not running", and the next start dies in the allocator
      # with a stack trace about engine initialisation that names no cause.
      # setsid at start time is what makes the group killable in one go.
      kill -TERM -- "-$PID" 2>/dev/null || kill -TERM "$PID" 2>/dev/null || true
      for _ in $(seq 1 30); do kill -0 "$PID" 2>/dev/null || break; sleep 1; done
      if kill -0 "$PID" 2>/dev/null; then
        kill -KILL -- "-$PID" 2>/dev/null || kill -KILL "$PID" 2>/dev/null || true
        sleep 1
      fi
      rm -f "$PIDF" "$SOCK"
      echo "stopped"
    elif [ -S "$SOCK" ]; then
      # Started some other way -- by hand, or by supervisor. Say so rather than
      # printing "stopped" over an engine that is still holding the card.
      rm -f "$PIDF"
      echo "!! there is an engine on $SOCK that this script did not start."
      echo "   supervisorctl stop meetscribe-engine, or kill it yourself:"
      echo "   ps aux | grep -E 'engined|EngineCore'"
      exit 1
    else
      rm -f "$PIDF" "$SOCK"
      echo "not running"
    fi ;;
  restart) "$0" stop; "$0" start ;;
  status)
    # rc 2 from --status means "up, but holding code older than pipeline/ on
    # disk" -- it prints why. Not a failure: the engine works, it is just not
    # the engine you think you deployed.
    OUT="$("$PY" "$HERE/pipeline/engined.py" --status --sock "$SOCK" 2>&1)"; RC=$?
    case "$RC" in
      0) echo "running — $SOCK" ;;
      2) echo "running — $SOCK"; echo "$OUT" | tail -n +2 ;;
      *) echo "not running"; exit 1 ;;
    esac ;;
  log) tail -n "${2:-40}" "$LOG" ;;
  -h|--help) sed -n '2,22p' "$0" ;;
  *) echo "usage: $0 {start|stop|restart|status|log}" >&2; exit 2 ;;
esac
