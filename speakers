#!/usr/bin/env bash
# Manage the voice profile store. A voice named once is recognised in every
# later meeting, so this is where naming happens.
#
#   ./speakers meetings                               what is in the library
#   ./speakers who <meeting>                          the voices, and what they said
#   ./speakers play <meeting> G02 [n]                 HEAR that voice
#   ./speakers list                                   who is on file
#   ./speakers name <meeting> <cluster> "Bob Smith"   remember this voice
#   ./speakers apply [--apply]                        re-label meetings you
#                                                     already have with what
#                                                     the store now knows
#
#   ./speakers rename <id> "New Name"
#   ./speakers forget <id>                            delete a person + voiceprints
#
# <meeting> is anything that identifies one: its id, its folder, a path to it,
# or enough of the title to be unambiguous. `./speakers meetings` lists them.
#
# Add --host <box> to any of these to work against a remote install; who/play/
# clips always run here, because they read the transcript and the audio.
#
set -euo pipefail

# No default: a remote box only exists if you name one, via --host or MS_HOST.
HOST="${MS_HOST:-}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Everything lives inside the checkout unless told otherwise.
REMOTE="${MS_REMOTE:-${MS_WORK:-$HERE}}"
PIPE="$REMOTE/pipeline"
LOCAL=0
[ -f "$PIPE/speakers.py" ] && [ -z "${MS_FORCE_REMOTE:-}" ] && LOCAL=1

# setup.sh installs into whichever interpreter already owns torch and records it
# in env.sh as MS_PY. Bare `python3` is often a different interpreter with none of
# the dependencies installed.
run() {  # run a command where the pipeline lives
  if [ "$LOCAL" -eq 1 ]; then
    # shellcheck disable=SC1090
    local PY; PY="$(. "$REMOTE/env.sh" 2>/dev/null; echo "${MS_PY:-python3}")"
    MS_WORK="$REMOTE" "$PY" "$@"
  elif [ -z "$HOST" ]; then
    echo "no pipeline at $PIPE, and no --host/MS_HOST set. Run ./setup.sh here first." >&2
    exit 2
  else
    local q=""
    for a in "$@"; do q="$q $(printf '%q' "$a")"; done
    ssh "$HOST" "PY=\"\$(. '$REMOTE/env.sh' 2>/dev/null; echo \"\${MS_PY:-python3}\")\"; \
                 MS_WORK='$REMOTE' \"\$PY\"$q" 2>&1 \
      | { grep -v '^Welcome to vast\|^Have fun\|^AI agents:' || true; }
  fi
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --host, taken from anywhere in the arguments. It only understood MS_HOST
# before, and even then kept using the LOCAL install path -- so on a laptop with
# a clone it silently read the laptop's empty profile store instead of the box's.
# Same fault ./transcribe had: the path this script sits in is not the path the
# install is at when the install is somewhere else.
ARGS=()
for a in "$@"; do
  case "${_next:-}" in host) HOST="$a"; _next=""; continue ;; esac
  case "$a" in --host) _next=host ;; *) ARGS+=("$a") ;; esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

if [ -n "$HOST" ] && [ -z "${MS_REMOTE:-}" ] && [ -z "${MS_WORK:-}" ]; then
  LOCAL=0
  REMOTE="$(ssh "$HOST" '
    if [ -s /etc/meetscribe-work ]; then cat /etc/meetscribe-work; exit; fi
    for d in /opt/meetscribe "$HOME/meetscribe-cli" /workspace/meetscribe-cli \
             /opt/meetscribe-cli "$HOME/meetscribe"; do
      [ -x "$d/speakers" ] && { echo "$d"; exit; }
    done' 2>/dev/null | tail -1)"
  [ -n "$REMOTE" ] || { echo "cannot find a meetscribe install on $HOST." >&2
    echo "Run ./setup.sh there, or name it: MS_REMOTE=/path ./speakers ... --host $HOST" >&2
    exit 2; }
  PIPE="$REMOTE/pipeline"
fi

# The interpreter that owns the dependencies, resolved once. It was local to
# run() and the library lookups below need it as well.
PY="$(. "$HERE/env.sh" 2>/dev/null; echo "${MS_PY:-python3}")"

CMD="${1:-list}"; shift || true
case "$CMD" in
  who|play|clips)
    # These read the transcript and the clips, both of which live HERE in the
    # library, not on the box. You cannot name a voice you have not heard.
    #
    # Take a meeting reference as well as a path: after the restructure the
    # transcript is at library/<slug>-<id>/<slug>-transcript.json, which is not
    # something anyone should have to type.
    REF="${1:-}"; shift || true
    T="$(MS_WORK="$HERE" "$PY" "$HERE/pipeline/library.py" "$REF" transcript 2>/dev/null)" || T=""
    [ -n "$T" ] && [ -f "$T" ] || T="$REF"
    python3 "$HERE/preview.py" "$CMD" "$T" "$@"
    ;;
  list)
    run "$PIPE/speakers.py" list
    ;;
  apply|relabel)
    # A voice named once should be recognised everywhere, INCLUDING backwards.
    # identify.py runs when a recording is processed, against whoever was
    # enrolled then, so naming someone afterwards left every meeting they were
    # already in still calling them Speaker 3.
    run "$PIPE/relabel.py" "$@"
    ;;
  meetings)
    # From the library, via library.py, so this cannot drift from the naming
    # rules the way listing files in out/ did.
    printf "  %-46s %-7s %s\n" "FOLDER" "ID" "TITLE"
    if [ "$LOCAL" -eq 1 ]; then
      MS_WORK="$REMOTE" "$PY" "$PIPE/library.py"
    else
      ssh "$HOST" "MS_WORK='$REMOTE' \"\$(. '$REMOTE/env.sh' 2>/dev/null; echo \"\${MS_PY:-python3}\")\" '$PIPE/library.py'"
    fi | awk -F'\t' '{printf "  %-46s %-7s %s\n", $1, $2, $3}'
    ;;
  name)
    [ $# -ge 3 ] || { echo 'usage: ./speakers name <meeting> <cluster> "Full Name"' >&2; exit 2; }
    MEETING="$1"; CLUSTER="$2"; NAME="$3"
    # accept the transcript path as well as the bare meeting name
    MEETING="$(basename "$MEETING")"; MEETING="${MEETING%.json}"; MEETING="${MEETING%.txt}"
    RAW="$MEETING"

    # Ask library.py, rather than guessing at filenames. It resolves an id, a
    # folder name, a path, or enough of the title to be unambiguous -- and it
    # returns the meeting's ID, which is what identify.py keys on now. Naming a
    # voice therefore survives the folder being renamed or the meeting being
    # re-run with --replace.
    MDIR="$(MS_WORK="$REMOTE" "$PY" "$PIPE/library.py" "$RAW" path 2>/dev/null)" || MDIR=""
    if [ -n "$MDIR" ]; then
      MID="$(MS_WORK="$REMOTE" "$PY" "$PIPE/library.py" "$RAW" id)"
      CL="$(MS_WORK="$REMOTE" "$PY" "$PIPE/library.py" "$RAW" clusters)"
      [ -f "$CL" ] || { echo "no clusters in $MDIR — transcribe it first." >&2; exit 2; }
      run "$PIPE/identify.py" --clusters "$CL" --meeting "$MID" \
          --enroll "${CLUSTER}=${NAME}"
      echo
      echo "  Re-run transcribe on that meeting to see the name in the transcript,"
      echo "  or just transcribe the next one — they are recognised from now on."
      exit 0
    fi

    MEETING="$(echo "$MEETING" | tr -cs '[:alnum:]._-' '-' | sed 's/^-*//;s/-*$//')"

    # HERE first. ./transcribe brings the clusters file back with the transcript,
    # so naming a voice is something you can do where your files are -- without a
    # box, and without one having to still exist. Only fall through to the remote
    # out/ when there is nothing local, which is the case where you transcribed
    # straight on the box and never pulled anything down.
    CL=""
    for c in "./${RAW}.clusters.npz" "./${MEETING}.clusters.npz" \
             "./${MEETING}_linked_clusters.npz" "./out/${MEETING}.clusters.npz" \
             "./out/${MEETING}_linked_clusters.npz"; do
      [ -f "$c" ] && { CL="$c"; break; }
    done
    if [ -n "$CL" ]; then
      # A local file means a local run, whatever --host says: the store this
      # writes to is the one in THIS install, which is the copy that outlives
      # any box.
      LOCAL=1; PIPE="$HERE/pipeline"; REMOTE="$HERE"
      run "$PIPE/identify.py" --clusters "$CL" \
          --meeting "$MEETING" --enroll "${CLUSTER}=${NAME}"
    else
      [ "$LOCAL" -eq 1 ] && [ ! -f "$REMOTE/out/${MEETING}_linked_clusters.npz" ] && {
        echo "no clusters for $MEETING here." >&2
        echo "Looked for ${RAW}.clusters.npz and ${MEETING}.clusters.npz in $(pwd)" >&2
        echo "and out/ beside it. Transcribe it first, or name it on the box:" >&2
        echo "  ./speakers name '$RAW' $CLUSTER '$NAME' --host <box>" >&2
        exit 2; }
      run "$PIPE/identify.py" --clusters "$REMOTE/out/${MEETING}_linked_clusters.npz" \
          --meeting "$MEETING" --enroll "${CLUSTER}=${NAME}"
    fi
    echo
    echo "  Re-run transcribe on that meeting to see the name in the transcript,"
    echo "  or just transcribe the next one — they are recognised from now on."
    ;;
  rename)
    [ $# -ge 2 ] || { echo 'usage: ./speakers rename <id> "New Name"' >&2; exit 2; }
    run "$PIPE/speakers.py" rename "$1" "$2"
    ;;
  forget)
    [ $# -ge 1 ] || { echo 'usage: ./speakers forget <id>' >&2; exit 2; }
    run "$PIPE/speakers.py" forget "$1"
    ;;
  -h|--help|help)
    sed -n '2,11p' "$0"
    ;;
  *)
    echo "unknown command: $CMD" >&2; sed -n '2,11p' "$0" >&2; exit 2
    ;;
esac
