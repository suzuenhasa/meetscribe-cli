#!/usr/bin/env bash
# Transcribe a meeting on the GPU box and drop the transcript in the current directory.
#
#   ./transcribe "Product Marketing Meeting.mp3"
#   ./transcribe ~/recordings/              a whole folder — engine loads ONCE
#   ./transcribe podcast.mp3 --overlap 0     # disable window context (default 5s)
#   ./transcribe ~/recordings/ --gpu-frac 0.80   # override the derived VRAM split
#   ./transcribe podcast.mp3 --glossary "Sreeram Kannan,EigenCloud,EigenDA"
#   ./transcribe standup.mp3 --name G01="Bob Smith"    remember this voice, by name
#   ./transcribe standup.mp3 --roster "Bob Smith,Jane Doe"   only score these people
#   ./transcribe meeting.m4a --thr 0.70     # pin the cut by hand (rarely needed)
#
# On --glossary: names the model has never heard come out as the nearest familiar
# English -- "I'm Sreeram" was transcribed "I'm sure I'm a, I'm", and "EigenCloud"
# as "Igen Club". Post-hoc search-and-replace cannot fix that safely because the
# output is valid English, so the words have to reach the decoder. Measured: fixes
# both, inserts nothing into audio that lacks the terms, and leaves the rest of the
# transcript 98%% identical. Terms are also read from ./glossary.txt if present, one
# per line, so you do not have to retype them.
#
# Uploads, runs transcribe -> embed -> link -> transcript, brings back the .txt and .json.
#
# On --thr: the clustering cut used to be a constant you had to guess per recording setup,
# and guessing wrong silently merged every speaker into one. It is now self-calibrated per
# meeting (--thr auto, the default) from MOSS's own within-window speaker labels; see
# bench/cluster_speakers.py. Pass a number only to override it.
set -euo pipefail

# No default: a remote box only exists if you name one, via --host or MS_HOST.
HOST="${MS_HOST:-}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Everything lives inside the checkout unless told otherwise.
REMOTE="${MS_REMOTE:-${MS_WORK:-$HERE}}"
PIPE="$REMOTE/pipeline"
need_host() {
  [ -n "$HOST" ] || { echo "no pipeline at $PIPE, and no --host given." >&2
    echo "Either run ./setup.sh here, or point at a box: --host <sshhost>" >&2; exit 2; }
}
THR="auto"
ROSTER=""
ENROLL=""
# Running ON the machine that has the pipeline? Then there is nothing to ssh to.
# Set MS_FORCE_REMOTE to use the box even when a local install exists.
LOCAL=0
[ -f "$PIPE/transcribe_meeting.py" ] \
  && [ -z "${MS_FORCE_REMOTE:-}" ] && LOCAL=1
WINDOW="30"
OVERLAP="5"
GPUFRAC=""
SRC=""
GLOSSARY=""

rrun() {   # execute a shell snippet where the pipeline lives
  if [ "$LOCAL" -eq 1 ]; then bash -c "$1"
  elif [ -z "$HOST" ]; then need_host
  else
    # `|| true`: grep exits 1 when it filters every line away (a command with no
    # output, e.g. mkdir), and under `set -e` that would kill the run.
    ssh "$HOST" "$1" 2>&1 | { grep -v '^Welcome to vast\|^Have fun\|^AI agents:' || true; }
  fi
}
rput() {   # local file -> pipeline machine
  if [ "$LOCAL" -eq 1 ]; then [ "$1" = "$2" ] || cp -f "$1" "$2"
  else rsync -a --partial "$1" "$HOST:$2"; fi
}
rget() {   # pipeline machine -> here
  if [ "$LOCAL" -eq 1 ]; then cp -f "$1" "$2" 2>/dev/null || true
  else rsync -a "$HOST:$1" "$2" 2>/dev/null || true; fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --thr)      THR="$2"; shift 2 ;;
    --glossary) GLOSSARY="$2"; shift 2 ;;
    --roster)   ROSTER="$2"; shift 2 ;;
    --name)     ENROLL="$ENROLL --enroll $2"; shift 2 ;;
    --window)  WINDOW="$2"; shift 2 ;;
    --overlap) OVERLAP="$2"; shift 2 ;;
    --gpu-frac) GPUFRAC="$2"; shift 2 ;;
    --host)   HOST="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *)        SRC="$1"; shift ;;
  esac
done
# VLLM_CACHE_ROOT travels with the install for the same reason everything else
# does: vLLM's compiled graph is cached per model, per engine config and per GPU
# model name, and the FIRST build of it costs 120-400s against ~70s for every one
# after. Left to its default it lands in ~/.cache/vllm, which meant a cache warmed
# by provisioning under the install directory was never read -- measured on a
# 3090: 50 MB written where nobody looked, then 49 MB compiled again at runtime.
#
# setup.sh installs into whichever interpreter already owns torch and records it
# in env.sh as MS_PY. Bare `python3` is frequently a DIFFERENT interpreter with none
# of the dependencies -- the failure is ModuleNotFoundError: numpy, which looks like
# a broken install rather than the wrong python. Resolve it ONCE, here, and pass the
# literal path down; computing it inside each remote snippet turns into a quoting
# fight with no upside.
if [ "$LOCAL" -eq 1 ]; then
  PY="$(. "$REMOTE/env.sh" 2>/dev/null; echo "${MS_PY:-python3}")"
else
  PY="$(ssh "$HOST" ". '$REMOTE/env.sh' 2>/dev/null; echo \"\${MS_PY:-python3}\"" 2>/dev/null | tail -1)"
  [ -n "$PY" ] || PY=python3
fi

# A directory means batch: the engine loads once instead of per file (~66s each),
# and embedding overlaps the next file's transcription.
if [ -d "$SRC" ]; then
  # -L so a directory of SYMLINKS works: the UI stages a batch by linking rather
  # than copying gigabytes of audio, and plain -type f does not match a symlink.
  mapfile -t BATCH < <(find -L "$SRC" -maxdepth 1 -type f \( -iname '*.wav' -o -iname '*.mp3' \
      -o -iname '*.m4a' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.mp4' \
      -o -iname '*.webm' \) | sort)
  [ ${#BATCH[@]} -gt 0 ] || { echo "no audio files in $SRC" >&2; exit 2; }
  echo "==> ${#BATCH[@]} files in $(basename "$SRC")"
  if [ -f "./glossary.txt" ]; then
    FILE_TERMS="$(grep -vE '^\s*(#|$)' ./glossary.txt | paste -sd, -)"
    [ -n "$FILE_TERMS" ] && GLOSSARY="${GLOSSARY:+$GLOSSARY,}$FILE_TERMS"
  fi
  [ -n "$GLOSSARY" ] && echo "==> glossary: $GLOSSARY"
  rrun "mkdir -p '$REMOTE/inbox' '$REMOTE/out'"
  REMOTE_ARGS=(); TITLES="$(mktemp)"; printf '{' > "$TITLES"; FIRST=1
  for f in "${BATCH[@]}"; do
    b="$(basename "${f%.*}")"; e="${f##*.}"
    sf="$(echo "$b" | tr -cs '[:alnum:]._-' '-' | sed 's/^-*//;s/-*$//')"
    [ "$LOCAL" -eq 1 ] || echo "    uploading $(basename "$f")"
    rput "$f" "$REMOTE/inbox/$sf.$e"
    REMOTE_ARGS+=("$REMOTE/inbox/$sf.$e")
    [ $FIRST -eq 0 ] && printf ',' >> "$TITLES"; FIRST=0
    python3 -c 'import json,sys; print(json.dumps(sys.argv[1])+":"+json.dumps(sys.argv[2]), end="")' "$sf" "$b" >> "$TITLES"
  done
  printf '}' >> "$TITLES"
  rput "$TITLES" "$REMOTE/out/_titles.json"; rm -f "$TITLES"
  # Do NOT let set -e abort here. batch.py now exits nonzero when any single
  # recording fails, and the rest of the batch has still succeeded -- aborting
  # would throw away every good transcript over one bad file, having already
  # paid for the whole run. Capture the code, retrieve what exists, exit with it.
  BATCH_RC=0
  rrun "
    set -uo pipefail
    export HF_HOME='$REMOTE/.hf_home' MS_WORK='$REMOTE' OMP_NUM_THREADS=8 \
           VLLM_CACHE_ROOT='$REMOTE/.vllm_cache' \
           TOKENIZERS_PARALLELISM=false VLLM_LOGGING_LEVEL=WARNING
    cd '$REMOTE'
    ARGS=(${REMOTE_ARGS[*]@Q} --out-dir '$REMOTE/out' \
      --window $WINDOW --overlap $OVERLAP --thr $THR \
      --glossary $(printf '%q' "$GLOSSARY") --roster $(printf '%q' "$ROSTER") \
      --titles '$REMOTE/out/_titles.json' ${GPUFRAC:+--gpu-frac $GPUFRAC})
    # Hand the job to the resident engine if the box is running one, which saves
    # the ~70s load. 97 is engined.py saying it could not -- no daemon, a stale
    # socket, or an engine built for different windows -- having already printed
    # which. Run it here in that case, exactly as this line did before daemons.
    "$PY" '$PIPE/engined.py' --submit -- \"\${ARGS[@]}\"
    rc=\$?
    [ \$rc -eq 97 ] && { "$PY" '$PIPE/batch.py' \"\${ARGS[@]}\"; rc=\$?; }
    exit \$rc
  " || BATCH_RC=$?

  echo "==> retrieving"
  GOT=0; WANT=0; MISSING=(); SEEN=" "
  for f in "${BATCH[@]}"; do
    b="$(basename "${f%.*}")"
    sf="$(echo "$b" | tr -cs '[:alnum:]._-' '-' | sed 's/^-*//;s/-*$//')"
    # Two inputs can sanitise to the same remote stem, and there is only ONE
    # remote transcript for them. Counting per input would claim to have
    # delivered two files that are the same file.
    case "$SEEN" in *" $sf "*) continue ;; esac
    SEEN="$SEEN$sf "; WANT=$((WANT + 1))
    # Clear the destinations first. rget deliberately swallows failure so one
    # absent file cannot abort the loop -- which means it leaves whatever was
    # already here, and a transcript from an EARLIER run would be counted as
    # delivered by this one, hiding exactly the omission this check exists for.
    rm -f "./${b}.txt" "./${b}.json"
    rget "$REMOTE/out/${sf}.txt" "./${b}.txt"
    rget "$REMOTE/out/${sf}_linked.json" "./${b}.json"
    # The per-segment embeddings, without which a transcript can be read but no
    # voice in it can ever be named -- the UI needs them beside the .json to
    # enrol anyone, and they are a couple of hundred KB. Not part of the
    # completeness check below: a missing one costs identification, not the
    # transcript, so it must not fail the run.
    rget "$REMOTE/out/${sf}_emb.npz" "./${b}.emb.npz"
    if [ -s "./${b}.txt" ] && [ -s "./${b}.json" ]; then
      GOT=$((GOT + 1))
    else
      MISSING+=("$b")
    fi
  done
  echo "    $GOT of $WANT transcripts in $(pwd)"
  if [ "${#MISSING[@]}" -gt 0 ]; then
    echo "    !! no transcript for: ${MISSING[*]}" >&2
    [ "$BATCH_RC" -eq 0 ] && BATCH_RC=1
  fi
  exit "$BATCH_RC"
fi

[ -f "$SRC" ] || { echo "usage: transcribe <audio-file> [--glossary \"Name,Term\"] [--window 30] [--thr auto]" >&2; exit 2; }

# ./glossary.txt (one term per line, # comments ok) is merged in automatically.
if [ -f "./glossary.txt" ]; then
  FILE_TERMS="$(grep -vE '^\s*(#|$)' ./glossary.txt | paste -sd, -)"
  [ -n "$FILE_TERMS" ] && GLOSSARY="${GLOSSARY:+$GLOSSARY,}$FILE_TERMS"
fi
[ -n "$GLOSSARY" ] && echo "==> glossary: $GLOSSARY"

# safe remote name: no spaces or parens to fight with over ssh
BASE="$(basename "${SRC%.*}")"
SAFE="$(echo "$BASE" | tr -cs '[:alnum:]._-' '-' | sed 's/^-*//;s/-*$//')"
EXT="${SRC##*.}"

echo "==> $BASE"
rrun "mkdir -p '$REMOTE/inbox' '$REMOTE/out'; supervisorctl stop ray >/dev/null 2>&1 || true"

[ "$LOCAL" -eq 1 ] || echo "==> uploading $(du -h "$SRC" | cut -f1)"
rput "$SRC" "$REMOTE/inbox/$SAFE.$EXT"

echo "==> transcribing"
# A single recording is where a resident engine matters most: the five steps
# below are seconds of work behind a ~70s engine load, so a voice memo spends
# almost all of its wall clock starting up. batch.py does all five for a queue
# of one, so when the box has a daemon, hand it the file and skip the load.
#
# Not with --name: enrolling a voice is identify.py's --enroll, which the batch
# path has no equivalent for. Rather than half-support it, take the slow path.
SINGLE_DONE=0
if [ -z "$ENROLL" ]; then
  T1="$(mktemp)"
  # batch.py names transcripts from the sanitised remote filename; this is what
  # gives the header back the title the human actually used.
  printf '{%s}' "$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1])+":"+json.dumps(sys.argv[2]), end="")' "$SAFE" "$BASE")" > "$T1"
  rput "$T1" "$REMOTE/out/_titles.json"; rm -f "$T1"
  SINGLE_RC=0
  rrun "
    set -uo pipefail
    cd '$REMOTE'
    export HF_HOME='$REMOTE/.hf_home' MS_WORK='$REMOTE' VLLM_CACHE_ROOT='$REMOTE/.vllm_cache' \
           OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false VLLM_LOGGING_LEVEL=WARNING
    "$PY" '$PIPE/engined.py' --submit -- '$REMOTE/inbox/$SAFE.$EXT' \
      --out-dir '$REMOTE/out' --window $WINDOW --overlap $OVERLAP --thr $THR \
      --glossary $(printf '%q' "$GLOSSARY") --roster $(printf '%q' "$ROSTER") \
      --titles '$REMOTE/out/_titles.json' ${GPUFRAC:+--gpu-frac $GPUFRAC}
  " || SINGLE_RC=$?
  # 97 is "no usable daemon" and is the one code that means fall through; any
  # other failure is a real one and the steps below would only repeat it.
  if [ "$SINGLE_RC" -eq 0 ]; then SINGLE_DONE=1
  elif [ "$SINGLE_RC" -ne 97 ]; then exit "$SINGLE_RC"
  fi
fi

[ "$SINGLE_DONE" -eq 1 ] || rrun "
  set -euo pipefail
  cd '$REMOTE'
  export HF_HOME='$REMOTE/.hf_home' VLLM_CACHE_ROOT='$REMOTE/.vllm_cache' \
         OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false \
         VLLM_LOGGING_LEVEL=WARNING PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

  "$PY" '$PIPE/transcribe_meeting.py' '$REMOTE/inbox/$SAFE.$EXT' --window $WINDOW \
      ${GPUFRAC:+--gpu-frac $GPUFRAC} \
      --overlap $OVERLAP --glossary '$GLOSSARY' \
      --out '$REMOTE/out/${SAFE}_raw.json' 2>&1 \
    | grep -E '^gen |silence gate|repetition|windows of' || true

  echo '==> embedding speakers'
  OMP_NUM_THREADS=4 "$PY" '$PIPE/link/embed_batched.py' \
      --run '$REMOTE/out/${SAFE}_raw.json' --wav '$REMOTE/inbox/$SAFE.$EXT' \
      --out '$REMOTE/out/${SAFE}_emb.npz' 2>&1 | tail -1

  echo '==> linking speakers (threshold: $THR)'
  OMP_NUM_THREADS=4 "$PY" '$PIPE/link/link.py' --run '$REMOTE/out/${SAFE}_raw.json' \
      --npz '$REMOTE/out/${SAFE}_emb.npz' --thr $THR \
      --out '$REMOTE/out/${SAFE}_linked.json' 2>&1 \
    | grep -E 'k_est=|FLOOR-VIOLATION' || true

  echo '==> identifying speakers'
  MS_WORK='$REMOTE' "$PY" '$PIPE/identify.py' \
      --clusters '$REMOTE/out/${SAFE}_linked_clusters.npz' --meeting '$SAFE' \
      --roster '$ROSTER' --names '$REMOTE/out/${SAFE}_names.json' $ENROLL

  "$PY" '$PIPE/mktxt.py' '$REMOTE/out/${SAFE}_linked.json' '$REMOTE/out/${SAFE}_raw.json' \
      '$REMOTE/out/${SAFE}.txt' '$BASE' '$REMOTE/out/${SAFE}_names.json'
"

echo "==> retrieving"
rget "$REMOTE/out/${SAFE}.txt" "./${BASE}.txt"
rget "$REMOTE/out/${SAFE}_linked.json" "./${BASE}.json"
# Same as the batch path: without the embeddings a transcript can be read but no
# voice in it can ever be named.
rget "$REMOTE/out/${SAFE}_emb.npz" "./${BASE}.emb.npz"
echo "    $(pwd)/${BASE}.txt"
echo "    $(pwd)/${BASE}.json"
