#!/usr/bin/env bash
# Transcribe a meeting on the GPU box and drop the transcript in the current directory.
#
#   ./transcribe "Platform Review.mp3"
#   ./transcribe ~/recordings/              a whole folder — engine loads ONCE
#   ./transcribe ~/recordings/ --out ~/done  a library somewhere else
#   ./transcribe fixed.mp3 --replace 9ajq9   redo a meeting, keeping its id
#   ./transcribe podcast.mp3 --overlap 5     # give each window 5s of context (off by default)
#   ./transcribe ~/recordings/ --gpu-frac 0.80   # override the derived VRAM split
#   ./transcribe podcast.mp3 --glossary "Dana Whitfield,Northwind,NorthwindDA"
#   ./transcribe interview.mp3 --glossary crypto.txt   a file of terms, one per line
#   ./transcribe standup.mp3 --roster "Bob Smith,Jane Doe"   only score these people
#   ./transcribe *.m4a --manifest week.json   a glossary AND roster per recording
#   ./transcribe *.m4a --no-clips             skip the per-voice sample clips
#   ./transcribe meeting.m4a --thr 0.70     # pin the cut by hand (rarely needed)
#
# On --glossary: names the model has never heard come out as the nearest familiar
# English -- "I'm Dana" was transcribed "I'm the na, I'm", and "Northwind"
# as "north wind". Post-hoc search-and-replace cannot fix that safely because the
# output is valid English, so the words have to reach the decoder. Measured: fixes
# both, inserts nothing into audio that lacks the terms, and leaves the rest of the
# transcript 98%% identical. Terms are also read from ./glossary.txt if present, one
# per line, so you do not have to retype them.
#
# Uploads, runs transcribe -> embed -> link -> transcript, brings back the .txt and .json.
#
# On --thr: the clustering cut used to be a constant you had to guess per recording setup,
# and guessing wrong silently merged every speaker into one. It is now self-calibrated per
# meeting (--thr auto, the default) from MOSS's own within-window speaker labels; see
# bench/cluster_speakers.py. Pass a number only to override it.
set -euo pipefail

# No default: a remote box only exists if you name one, via --host or MS_HOST.
HOST="${MS_HOST:-}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Everything lives inside the checkout unless told otherwise.
REMOTE="${MS_REMOTE:-${MS_WORK:-$HERE}}"
PIPE="$REMOTE/pipeline"
need_host() {
  [ -n "$HOST" ] || { echo "no pipeline at $PIPE, and no --host given." >&2
    echo "Either run ./setup.sh here, or point at a box: --host <sshhost>" >&2; exit 2; }
}
# Refuse while the box is still building itself. vast marks an instance ready
# when the CONTAINER boots, minutes before provisioning finishes, so ssh lets you
# in and this directory already looks like an install. Running now fails in ways
# that read as bugs in this script -- a missing weight, an engine that will not
# fit beside the one provisioning is about to start -- rather than as "wait".
# The marker is written by vast/provision.sh and removed when it is done, so a
# plain ./setup.sh install never has one and is never blocked.
provisioning_guard() {
  # Provisioning itself runs this script -- the warm-up transcription, and
  # ./engine start when supervisor did not. Without this exemption the guard
  # blocked the very steps that make the box ready: the warm-up refused, so the
  # compile cache stayed empty, so the engine took longer than provisioning's
  # wait, so it reported "not resident" on a box that was otherwise perfect.
  # One guard, three symptoms, none of them looking like the cause.
  [ -z "${MS_PROVISIONING:-}" ] || return 0
  local m="$1/.provisioning"
  [ -f "$m" ] || return 0
  local since; since="$(cat "$m" 2>/dev/null)"
  echo "meetscribe is still being set up on this machine (started ${since:-recently})." >&2
  echo "It takes about 5-8 minutes: ~2 GB of weights, then a one-off engine compile." >&2
  echo "  watch it:   tail -f /var/log/onstart.log" >&2
  echo "  it is done when:  $1/.provisioned exists" >&2
  exit 75            # EX_TEMPFAIL: try again shortly, nothing is wrong
}

THR="auto"
ROSTER=""
# Speaker-identity knobs, forwarded verbatim to batch.py. One string rather than
# a variable each because this script has no opinion on them -- batch.py owns
# every default, and empty means "send nothing", so those defaults stay the
# single source of truth.
TUNE=""
# Running ON the machine that has the pipeline? Then there is nothing to ssh to.
# Decided AFTER the argument loop, because --host has to be able to win: this
# test is "does pipeline/transcribe_meeting.py exist", that file is tracked in
# git, so it exists in every clone -- including a laptop with no GPU and nothing
# installed. Deciding here would make `./transcribe rec.mp3 --host box`, the
# command the README and the vast template both tell people to run, quietly run
# on the laptop and fail on the import.
# Set MS_FORCE_REMOTE to use the box even when a local install exists.
LOCAL=0
WINDOW="30"
OVERLAP="0"
GPUFRAC=""
SRC=""
SRCS=()
GLOSSARY=""
MANIFEST=""
NOCLIPS=""
OUTDIR=""
REPLACE=""

# --glossary takes terms OR a file of them. Different subjects need different
# vocabularies -- a crypto interview and an archaeology seminar share nothing --
# and keeping each in its own file is the obvious way to manage that. Without
# this, passing a filename sent the literal string "crypto.txt" to the model as
# a term to listen out for: wrong, and silently so.
read_glossary() {
  if [ -f "$1" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$1" | paste -sd, -
    return
  fi
  # Looks like a path and is not one. Left alone it becomes a TERM -- the model
  # would be told to listen for the words "crypto.txt" -- and nothing would ever
  # say the file was missing.
  case "$1" in
    */*|*.txt|*.list)
      echo "no glossary file at $1" >&2
      echo "  (a --glossary with no commas and a path-like name is read as a file)" >&2
      exit 2 ;;
  esac
  printf '%s' "$1"
}

rrun() {   # execute a shell snippet where the pipeline lives
  if [ "$LOCAL" -eq 1 ]; then bash -c "$1"
  elif [ -z "$HOST" ]; then need_host
  else
    # `|| true`: grep exits 1 when it filters every line away (a command with no
    # output, e.g. mkdir), and under `set -e` that would kill the run.
    ssh "$HOST" "$1" 2>&1 | { grep -v '^Welcome to vast\|^Have fun\|^AI agents:' || true; }
  fi
}
rput() {   # local file -> pipeline machine
  if [ "$LOCAL" -eq 1 ]; then [ "$1" = "$2" ] || cp -f "$1" "$2"
  else rsync -a --partial "$1" "$HOST:$2"; fi
}
rget() {   # pipeline machine -> here
  if [ "$LOCAL" -eq 1 ]; then cp -f "$1" "$2" 2>/dev/null || true
  else rsync -a "$HOST:$1" "$2" 2>/dev/null || true; fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --thr)      THR="$2"; shift 2 ;;
    --glossary) GLOSSARY="$(read_glossary "$2")"; shift 2 ;;
    --no-clips) NOCLIPS="--no-clips"; shift ;;
    --manifest)
      [ -f "$2" ] || { echo "no manifest at $2" >&2; exit 2; }
      MANIFEST="$2"; shift 2 ;;
    --roster)   ROSTER="$2"; shift 2 ;;
    # Enrolling during a run only ever existed on the five-script fallback,
    # as identify.py --enroll, and it named a CLUSTER -- one voice in one
    # recording -- which is not the unit anything downstream names. Deleting
    # that chain deleted the only implementation, so say so: accepting the
    # argument and dropping it is how a voice ends up unnamed and nobody knows.
    --name)
      WANT="${2:-Full Name}"; WANT="${WANT#*=}"
      echo "--name is gone: it only ran on the no-daemon fallback, never with a resident engine," >&2
      echo "and it named one recording's cluster rather than the person. Transcribe first, then:" >&2
      echo "    ./speakers link --apply      group the voices across meetings" >&2
      echo "    ./speakers review            the groups waiting for a name" >&2
      echo "    ./speakers name <group> \"$WANT\"" >&2
      exit 2 ;;
    --window)  WINDOW="$2"; shift 2 ;;
    --overlap) OVERLAP="$2"; shift 2 ;;
    --gpu-frac) GPUFRAC="$2"; shift 2 ;;
    # --min-core, --refine, --durable, --guard and --min-cluster-sec used to sit
    # on this arm too. They reach link.py and are read only inside its
    # --legacy-cluster branch, which nothing here passes -- so they printed into
    # the AGG and CLUSTER lines, looked honoured, and changed nothing. link.py
    # still takes them for a direct run.
    --per-speaker)  TUNE="$TUNE $1 $2"; shift 2 ;;
    --overlap-aware) TUNE="$TUNE --overlap-aware"; shift ;;
    --accurate)      TUNE="$TUNE --accurate"; shift ;;
    --host)   HOST="$2"; shift 2 ;;
    --out)    OUTDIR="$2"; shift 2 ;;
    --replace) REPLACE="$2"; shift 2 ;;
    -h|--help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
    # Accumulate. This used to be SRC="$1", so `./transcribe a.mp3 b.mp3 c.mp3`
    # -- and every glob, which is how anyone writes a batch -- silently kept only
    # the LAST file and transcribed one recording of three. It reported success.
    *)        SRCS+=("$1"); shift ;;
  esac
done

# No argument means the inbox. It is a worklist: drop audio in, run this, and
# anything still sitting there afterwards has not been processed -- a property
# you can see at a glance, which pointing at arbitrary directories never gives
# you. An argument still means that path, for the one-off someone sends you.
if [ -z "$SRC" ]; then
  mkdir -p "$HERE/inbox"
  SRC="$HERE/inbox"
fi

# An explicit --host (or MS_HOST) means the box, full stop, whatever is sitting
# in this directory. Otherwise use a local install if there is a usable one.
if [ -n "$HOST" ]; then
  LOCAL=0
elif [ -f "$PIPE/transcribe_meeting.py" ] && [ -z "${MS_FORCE_REMOTE:-}" ]; then
  LOCAL=1
fi

# Where the install lives ON THE BOX, which is not where this script lives.
# REMOTE defaults to this checkout, which is right when you are ON the machine
# with the pipeline and wrong the moment you are not: every remote command below
# is built from it, so a laptop at ~/src/meetscribe-cli asked a box to run
# ~/src/meetscribe-cli/pipeline/engined.py and got "No such file or directory"
# for a file that was never going to be there.
#
# setup.sh and the provisioning script both record the path in
# /etc/meetscribe-work. Fall back to looking in the usual places, and say so
# plainly rather than failing halfway through a run with a path the user never
# typed. MS_REMOTE still overrides everything.
if [ "$LOCAL" -eq 0 ] && [ -n "$HOST" ] && [ -z "${MS_REMOTE:-}" ] && [ -z "${MS_WORK:-}" ]; then
  REMOTE="$(ssh "$HOST" '
    if [ -s /etc/meetscribe-work ]; then cat /etc/meetscribe-work; exit; fi
    for d in /opt/meetscribe "$HOME/meetscribe-cli" /workspace/meetscribe-cli              /opt/meetscribe-cli "$HOME/meetscribe"; do
      [ -x "$d/transcribe" ] && { echo "$d"; exit; }
    done' 2>/dev/null | tail -1)"
  [ -n "$REMOTE" ] || { echo "cannot find a meetscribe install on $HOST." >&2
    echo "Run ./setup.sh there, or name the directory: MS_REMOTE=/path ./transcribe ..." >&2
    exit 2; }
  PIPE="$REMOTE/pipeline"
  echo "==> using $HOST:$REMOTE"
fi
# VLLM_CACHE_ROOT travels with the install for the same reason everything else
# does: vLLM's compiled graph is cached per model, per engine config and per GPU
# model name, and the FIRST build of it costs 120-400s against ~70s for every one
# after. Left to its default it lands in ~/.cache/vllm, which meant a cache warmed
# by provisioning under the install directory was never read -- measured on a
# 3090: 50 MB written where nobody looked, then 49 MB compiled again at runtime.
#
# setup.sh installs into whichever interpreter already owns torch and records it
# in env.sh as MS_PY. Bare `python3` is frequently a DIFFERENT interpreter with none
# of the dependencies -- the failure is ModuleNotFoundError: numpy, which looks like
# a broken install rather than the wrong python. Resolve it ONCE, here, and pass the
# literal path down; computing it inside each remote snippet turns into a quoting
# fight with no upside.
[ "$LOCAL" -eq 1 ] && provisioning_guard "$REMOTE"

if [ "$LOCAL" -eq 1 ]; then
  PY="$(. "$REMOTE/env.sh" 2>/dev/null; echo "${MS_PY:-python3}")"
else
  PY="$(ssh "$HOST" ". '$REMOTE/env.sh' 2>/dev/null; echo \"\${MS_PY:-python3}\"" 2>/dev/null | tail -1)"
  [ -n "$PY" ] || PY=python3
fi
# Shell-quoted for splicing into the remote snippets below, where the path
# lands inside a double-quoted string and would otherwise word-split: setup.sh
# records MS_PY as $WORK/venv/bin/python, so a checkout under "My Recordings"
# truncated the snippet mid-path and ran a fragment.
PYQ="$(printf '%q' "$PY")"

# THE answer to "no usable daemon", written once and spliced into both
# branches. It used to be written twice: the batch branch re-ran batch.py in a
# process of its own, and the single-file branch ran a hand-rolled chain of five
# scripts that wrote a different artifact layout and named speakers a measurably
# worse way. Both branches build an ARGS array first; this runs it.
#
# 97 is engined.py saying it could not use the daemon -- none running, a stale
# socket, or an engine built for different windows -- having already printed
# which. --release before loading one of our own: a daemon that REFUSED a job is
# still holding the card, 17.6 of 24 GiB measured, and the load below fails for
# want of memory unless it steps aside. Harmless when there is no daemon, and it
# wakes for its next job in about a second.
RUN_JOB="
    $PYQ '$PIPE/engined.py' --submit -- \"\${ARGS[@]}\"
    rc=\$?
    if [ \$rc -eq 97 ]; then
      $PYQ '$PIPE/engined.py' --release >/dev/null 2>&1 || true
      $PYQ '$PIPE/batch.py' \"\${ARGS[@]}\"
      rc=\$?
    fi
    exit \$rc
"

# The profile store follows the WORK, not the machine. Without this a --host run
# matches against the BOX's profiles and everything it learns lands in the box's
# store, and both die with the instance -- so the one thing meetscribe exists to
# remember is the one thing a rented GPU cannot keep. Yours goes up before the
# run and comes back after; the box borrows it for as long as it is working.
#
# Local runs already use this file directly, so there is nothing to move.
DB="${MS_SPEAKER_DB:-$HERE/speakers.db}"
push_profiles() {
  [ "$LOCAL" -eq 1 ] && return 0
  [ -s "$DB" ] || return 0
  rput "$DB" "$REMOTE/speakers.db"
}
pull_profiles() {
  [ "$LOCAL" -eq 1 ] && return 0
  # Straight back over yours. The box only ever had a copy of this file, and the
  # only thing that can have changed on it is what this run just decided.
  rget "$REMOTE/speakers.db" "$DB"
}

# Where the results go: out/ BESIDE the audio, not wherever you happened to be
# standing. Transcribing a folder used to scatter a .txt, a .json, an .emb.npz
# and a .clusters.npz per recording into the current directory -- four files
# times however many meetings, mixed in with whatever else was there, and a
# different place each time depending on where you ran it from. Beside the audio
# they stay with the thing they describe. --out puts them somewhere else.
# The library: one directory per meeting, here, whatever machine did the work.
LIBRARY="${OUTDIR:-${MS_LIBRARY:-$HERE/library}}"
# Hand the resolved path to everything downstream. Without this the wrapper knows
# where the run went and library.py does not, which is how --out produced
# meetings that `./speakers link` could never find.
export MS_LIBRARY="$LIBRARY"
# --out is a path on the machine you typed the command on, and the meetings end
# up there either way. With --host the box works in its own library and rsyncs
# home; without one there is no trip, so the job writes there directly. Same
# destination, so the command does not change meaning when the GPU does.
#
# Unwritable is a warning, not a stop: the transcribing is the expensive part and
# it has not happened yet, so refusing here throws away nothing -- but refusing
# AFTER a remote run would strand finished work on a box you are about to
# destroy. Put it in the default library and say so.
if ! mkdir -p "$LIBRARY" 2>/dev/null; then
  echo "!! cannot write to $LIBRARY — using $HERE/library instead" >&2
  LIBRARY="$HERE/library"
  mkdir -p "$LIBRARY" || { echo "cannot write to $LIBRARY either" >&2; exit 2; }
fi
# Where the JOB writes, which is the box's own library on a remote run.
if [ "$LOCAL" -eq 1 ]; then JOBLIB="$LIBRARY"; else JOBLIB="$REMOTE/library"; fi
# Audio MOVES out of the inbox, because a worklist should empty as work
# completes. Anywhere else it is copied: emptying a directory the caller merely
# pointed at is not ours to do.
# A directory means batch: the engine loads once instead of per file (~66s each),
# and embedding overlaps the next file's transcription.
# One argument is a file or a directory; several are a batch. The directory
# branch below already knows how to run a list, so several files join it there
# rather than growing a third way to do the same thing.
MULTI=0
if [ ${#SRCS[@]} -gt 1 ]; then
  MULTI=1
  for f in "${SRCS[@]}"; do
    [ -f "$f" ] || { echo "not a file: $f" >&2; exit 2; }
  done
  SRC="$(dirname "${SRCS[0]}")"
elif [ ${#SRCS[@]} -eq 1 ]; then
  SRC="${SRCS[0]}"
fi

# Computed HERE, after SRC is resolved. It used to sit above, which was correct
# while the argument loop assigned SRC directly; once positionals started
# accumulating into SRCS the case ran against an unset SRC and never matched, so
# recordings in inbox/ were copied and the inbox never drained.
MOVEAUDIO=""
case "$(cd "$(dirname "${SRC%/}")" 2>/dev/null && pwd)/$(basename "${SRC%/}")" in
  "$HERE/inbox") MOVEAUDIO="--move-audio" ;;
esac

if [ -d "$SRC" ] || [ "$MULTI" -eq 1 ]; then
  # -L so a directory of SYMLINKS works: the UI stages a batch by linking rather
  # than copying gigabytes of audio, and plain -type f does not match a symlink.
  # .opus was missing and it is the default for a lot of recorders and for
  # yt-dlp, so a folder of them looked empty. Everything here is something
  # ffmpeg decodes and batch.py converts to 16 kHz mono before the run.
  if [ "$MULTI" -eq 1 ]; then
    BATCH=("${SRCS[@]}")
  else
  mapfile -t BATCH < <(find -L "$SRC" -maxdepth 1 -type f \( -iname '*.wav' -o -iname '*.mp3' \
      -o -iname '*.m4a' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.opus' \
      -o -iname '*.aac' -o -iname '*.m4b' -o -iname '*.aiff' -o -iname '*.wma' \
      -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) | sort)
  fi
  [ ${#BATCH[@]} -gt 0 ] || { echo "no audio files in $SRC" >&2; exit 2; }
  echo "==> ${#BATCH[@]} files${MULTI:+ }$([ "$MULTI" -eq 1 ] && echo "" || echo "in $(basename "$SRC")")${MOVEAUDIO:+ (they move into the library)}"
  if [ -f "./glossary.txt" ]; then
    FILE_TERMS="$(grep -vE '^\s*(#|$)' ./glossary.txt | paste -sd, -)"
    [ -n "$FILE_TERMS" ] && GLOSSARY="${GLOSSARY:+$GLOSSARY,}$FILE_TERMS"
  fi
  [ -n "$GLOSSARY" ] && echo "==> glossary: $GLOSSARY"
  # A directory PER RUN, not the shared inbox. Staging renames each file to a
  # sanitised form, so staging into the directory you were given writes new files
  # beside your originals -- and the next run over that directory picks those up
  # as more recordings. Run it twice on one folder and you transcribe everything
  # twice, under two names, which is also how two inputs came to claim one output
  # name. Nothing else needs these to outlive the run.
  STAGE="$REMOTE/inbox/run-$$"
  rrun "mkdir -p '$STAGE' '$REMOTE/out'"
  REMOTE_ARGS=(); TITLES="$(mktemp)"; printf '{' > "$TITLES"; FIRST=1
  for f in "${BATCH[@]}"; do
    b="$(basename "${f%.*}")"; e="${f##*.}"
    sf="$(echo "$b" | tr -cs '[:alnum:]._-' '-' | sed 's/^-*//;s/-*$//')"
    if [ "$LOCAL" -eq 1 ]; then
      # No staging when the pipeline is right here. Staging existed to give the
      # file a name that survives the trip over ssh, and the library does its
      # own naming now -- so a local run was copying every recording once for
      # nothing, and --move-audio moved the COPY and left the original sitting
      # in the inbox, which is the opposite of a worklist emptying.
      REMOTE_ARGS+=("$f")
    else
      echo "    uploading $(basename "$f")"
      rput "$f" "$STAGE/$sf.$e"
      REMOTE_ARGS+=("$STAGE/$sf.$e")
    fi
    [ $FIRST -eq 0 ] && printf ',' >> "$TITLES"; FIRST=0
    python3 -c 'import json,sys; print(json.dumps(sys.argv[1])+":"+json.dumps(sys.argv[2]), end="")' "$sf" "$b" >> "$TITLES"
  done
  printf '}' >> "$TITLES"
  rput "$TITLES" "$REMOTE/out/_titles.json"; rm -f "$TITLES"
  [ -n "$MANIFEST" ] && rput "$MANIFEST" "$REMOTE/inbox/_manifest.json"
  push_profiles
  # Do NOT let set -e abort here. batch.py now exits nonzero when any single
  # recording fails, and the rest of the batch has still succeeded -- aborting
  # would throw away every good transcript over one bad file, having already
  # paid for the whole run. Capture the code, retrieve what exists, exit with it.
  BATCH_RC=0
  rrun "
    set -uo pipefail
    export HF_HOME='$REMOTE/.hf_home' MS_WORK='$REMOTE' OMP_NUM_THREADS=8 \
           VLLM_CACHE_ROOT='$REMOTE/.vllm_cache' \
           TOKENIZERS_PARALLELISM=false VLLM_LOGGING_LEVEL=WARNING
    cd '$REMOTE'
    ARGS=(${REMOTE_ARGS[*]@Q} --out-dir '$REMOTE/out' \
      --library '$JOBLIB' $MOVEAUDIO ${REPLACE:+--replace $REPLACE} \
      --window $WINDOW --overlap $OVERLAP --thr $THR \
      --glossary $(printf '%q' "$GLOSSARY") --roster $(printf '%q' "$ROSTER") \
      ${MANIFEST:+--manifest '$REMOTE/inbox/_manifest.json'} $NOCLIPS \
      --titles '$REMOTE/out/_titles.json' ${GPUFRAC:+--gpu-frac $GPUFRAC}$TUNE)
$RUN_JOB" || BATCH_RC=$?

  rrun "rm -rf '$STAGE'" || true
  pull_profiles

  echo "==> retrieving"
  # Whole meeting directories, not files. Each holds its transcript, embeddings,
  # clips and meeting.json, and the directory IS the unit -- rebuilding that
  # from filenames here would be a second implementation of the naming rules, in
  # bash, guaranteed to drift from the one in library.py.
  #
  # The whole library rather than just this run's folders: rsync sends only what
  # is new, and a box is scratch that gets destroyed, so there is nothing on it
  # that is not also meant to be here.
  mkdir -p "$LIBRARY"
  if [ "$LOCAL" -eq 0 ]; then
    rsync -a -e "ssh" "$HOST:$REMOTE/library/" "$LIBRARY/" 2>/dev/null || true
  fi
  # A remote run moved the box's copy into the box's library; the local original
  # is still here, and the inbox only empties if we empty it.
  if [ "$LOCAL" -eq 0 ] && [ -n "$MOVEAUDIO" ] && [ "$BATCH_RC" -eq 0 ]; then
    for f in "${BATCH[@]}"; do rm -f "$f"; done
  fi
  GOT=$(find "$LIBRARY" -maxdepth 2 -name meeting.json 2>/dev/null | wc -l)
  echo "    $GOT meeting$([ "$GOT" = 1 ] || echo s) in $LIBRARY"
  exit "$BATCH_RC"
fi

[ -f "$SRC" ] || { echo "usage: transcribe <audio-file> [--glossary \"Name,Term\"] [--window 30] [--thr auto]" >&2; exit 2; }

# ./glossary.txt (one term per line, # comments ok) is merged in automatically.
if [ -f "./glossary.txt" ]; then
  FILE_TERMS="$(grep -vE '^\s*(#|$)' ./glossary.txt | paste -sd, -)"
  [ -n "$FILE_TERMS" ] && GLOSSARY="${GLOSSARY:+$GLOSSARY,}$FILE_TERMS"
fi
[ -n "$GLOSSARY" ] && echo "==> glossary: $GLOSSARY"

# safe remote name: no spaces or parens to fight with over ssh
BASE="$(basename "${SRC%.*}")"
SAFE="$(echo "$BASE" | tr -cs '[:alnum:]._-' '-' | sed 's/^-*//;s/-*$//')"
EXT="${SRC##*.}"

echo "==> $BASE"
rrun "mkdir -p '$REMOTE/inbox' '$REMOTE/out'; supervisorctl stop ray >/dev/null 2>&1 || true"

# No staging when the pipeline is right here -- the batch branch stopped doing
# it at :378-384 and this branch did not, which left the two disagreeing about
# the user's own file. Staging exists to give a recording a name that survives
# the trip over ssh; locally it copied every recording once for nothing, and
# then --move-audio moved the COPY into the library and left the original in
# inbox/, so the worklist never drained and the next run transcribed the same
# recording again under a second name. Worse for a name that needed no
# sanitising: `./transcribe inbox/sync.mp3` made rput cp a file onto itself and
# died with "are the same file", rc 1, before any work at all. Both executed.
if [ "$LOCAL" -eq 1 ]; then
  JOBSRC=("$SRC")
else
  echo "==> uploading $(du -h "$SRC" | cut -f1)"
  rput "$SRC" "$REMOTE/inbox/$SAFE.$EXT"
  JOBSRC=("$REMOTE/inbox/$SAFE.$EXT")
fi
push_profiles

echo "==> transcribing"
# One implementation, whichever way the run gets here. A single recording used
# to have a second one behind it: with no daemon it ran five scripts in sequence
# -- transcribe_meeting, embed_batched, link, identify, mktxt -- writing flat
# files into out/ with no library entry, no meeting.json and no clips, and
# running link.py with no --speaker-db, which is the measured-worse way to
# decide who is talking: 2.63% of speech under a wrong name against 0.18%
# (batch.py:957-963). Nothing chose between the two but whether a daemon
# happened to be up, and a fresh install has none -- so the unmaintained
# pipeline was the default for one recording while two recordings got the
# maintained one. batch.py does all five steps for a queue of one.
T1="$(mktemp)"
# batch.py names transcripts from the sanitised remote filename; this is what
# gives the header back the title the human actually used.
printf '{%s}' "$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1])+":"+json.dumps(sys.argv[2]), end="")' "$SAFE" "$BASE")" > "$T1"
rput "$T1" "$REMOTE/out/_titles.json"; rm -f "$T1"
[ -n "$MANIFEST" ] && rput "$MANIFEST" "$REMOTE/inbox/_manifest.json"
# Captured rather than fatal, for the batch branch's reason: the retrieval below
# has to run whatever the job did, so a run that died after writing its meeting
# still brings it home.
SINGLE_RC=0
rrun "
  set -uo pipefail
  export HF_HOME='$REMOTE/.hf_home' MS_WORK='$REMOTE' OMP_NUM_THREADS=4 \
         VLLM_CACHE_ROOT='$REMOTE/.vllm_cache' \
         TOKENIZERS_PARALLELISM=false VLLM_LOGGING_LEVEL=WARNING
  cd '$REMOTE'
  ARGS=(${JOBSRC[*]@Q} --out-dir '$REMOTE/out' \
    --library '$JOBLIB' $MOVEAUDIO ${REPLACE:+--replace $REPLACE} \
    --window $WINDOW --overlap $OVERLAP --thr $THR \
    --glossary $(printf '%q' "$GLOSSARY") --roster $(printf '%q' "$ROSTER") \
    ${MANIFEST:+--manifest '$REMOTE/inbox/_manifest.json'} $NOCLIPS \
    --titles '$REMOTE/out/_titles.json' ${GPUFRAC:+--gpu-frac $GPUFRAC}$TUNE)$RUN_JOB" || SINGLE_RC=$?

pull_profiles

echo "==> retrieving"
# Same as the batch path: the meeting directory is the unit, and the library is
# where it belongs regardless of which machine did the work.
mkdir -p "$LIBRARY"
if [ "$LOCAL" -eq 0 ]; then
  rsync -a -e "ssh" "$HOST:$REMOTE/library/" "$LIBRARY/" 2>/dev/null || true
fi
# `|| M=""`: the glob matches nothing when the run produced no meeting, ls
# exits 2, pipefail carries it through head, and set -e then kills the
# script AT THE ASSIGNMENT -- so the "nothing arrived" message below was
# unreachable and the run exited 2 in silence. Same shape as 7cadd9b.
M="$(ls -dt "$LIBRARY"/*/ 2>/dev/null | head -1)" || M=""
if [ -n "$M" ]; then
  echo "    ${M%/}"
else
  echo "    !! nothing arrived in $LIBRARY" >&2
fi
exit "$SINGLE_RC"
